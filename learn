Google Cloud Platform (GCP) infrastructure:

VPC Network → private cloud network for your resources

Subnets → subdivisions of the VPC for organizing workloads

Compute Engine VM → virtual machine to run applications

Cloud Storage Bucket → object storage for files/data

IAM & Service Accounts → access control and permissions

VPC & SUBNETS:
# VPC Network
resource "google_compute_network" "vpc_network" {
  name                    = "demo-vpc"
  auto_create_subnetworks = false
}
# Subnet
resource "google_compute_subnetwork" "subnet" {
  name          = "demo-subnet"
  ip_cidr_range = "10.0.0.0/24"
  region        = "us-central1"
  network       = google_compute_network.vpc_network.id
}

Virtual machine:
resource "google_compute_instance" "vm_instance" {
  name         = "demo-vm"
  machine_type = "e2-medium"
  zone         = "us-central1-a"

  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-11"
    }
  }

  network_interface {
    subnetwork = google_compute_subnetwork.subnet.id
    access_config {} # Assigns external IP
  }
}

Bucket:
resource "google_storage_bucket" "bucket" {
  name          = "demo-bucket-${var.project_id}"
  location      = "US"
  force_destroy = true
}

